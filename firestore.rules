rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection (strictly owner-scoped for patient privacy)
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // Family profiles
    match /family_profiles/{memberId} {
      allow read: if isAuthenticated() && resource.data.patientId == request.auth.uid;
      allow create: if isAuthenticated() &&
                    request.resource.data.patientId == request.auth.uid &&
                    request.resource.data.name is string &&
                    request.resource.data.relationship is string;
      allow update: if isAuthenticated() &&
                    resource.data.patientId == request.auth.uid &&
                    request.resource.data.patientId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.patientId == request.auth.uid;
    }

    // Appointments collection
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.specialistId == request.auth.uid
      );
      allow create: if isAuthenticated() &&
                    request.resource.data.patientId == request.auth.uid &&
                    isValidAppointment(request.resource.data);
      allow update: if isAuthenticated() &&
                    resource.data.patientId == request.auth.uid &&
                    isValidAppointment(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.patientId == request.auth.uid;
    }

    function isValidAppointment(data) {
      return data.patientId is string &&
             data.specialistId is string &&
             data.date is string &&
             data.timeSlot is string &&
             data.status in ['SCHEDULED', 'COMPLETED', 'CANCELLED'];
    }

    // Ambulance requests
    match /ambulance_requests/{requestId} {
      allow read: if isAuthenticated() && resource.data.patientId == request.auth.uid;
      allow create: if isAuthenticated() &&
                    request.resource.data.patientId == request.auth.uid &&
                    isValidAmbulanceRequest(request.resource.data);
      allow update: if isAuthenticated() && resource.data.patientId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.patientId == request.auth.uid;
    }

    function isValidAmbulanceRequest(data) {
      return data.patientId is string &&
             data.pickupAddress is string &&
             data.emergencyType is string &&
             data.status in ['DISPATCHED', 'EN_ROUTE', 'ARRIVED', 'COMPLETED'];
    }

    // Diagnostic test bookings
    match /diagnostic_bookings/{bookingId} {
      allow read: if isAuthenticated() && resource.data.patientId == request.auth.uid;
      allow create: if isAuthenticated() &&
                    request.resource.data.patientId == request.auth.uid &&
                    isValidDiagnosticBooking(request.resource.data);
      allow update: if isAuthenticated() &&
                    resource.data.patientId == request.auth.uid &&
                    isValidDiagnosticBooking(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.patientId == request.auth.uid;
    }

    function isValidDiagnosticBooking(data) {
      return data.patientId is string &&
             data.testName is string &&
             data.scheduledDate is string &&
             data.status in ['BOOKED', 'SAMPLE_COLLECTED', 'RESULTS_READY', 'CANCELLED'];
    }

    // Home healthcare bookings
    match /home_care_bookings/{bookingId} {
      allow read: if isAuthenticated() && resource.data.patientId == request.auth.uid;
      allow create: if isAuthenticated() &&
                    request.resource.data.patientId == request.auth.uid &&
                    request.resource.data.serviceTitle is string &&
                    request.resource.data.status in ['SCHEDULED', 'COMPLETED', 'CANCELLED'];
      allow update: if isAuthenticated() &&
                    resource.data.patientId == request.auth.uid &&
                    request.resource.data.patientId == request.auth.uid &&
                    request.resource.data.status in ['SCHEDULED', 'COMPLETED', 'CANCELLED'];
      allow delete: if isAuthenticated() && resource.data.patientId == request.auth.uid;
    }

    // Payments
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && resource.data.patientId == request.auth.uid;
      allow create: if isAuthenticated() &&
                    request.resource.data.patientId == request.auth.uid &&
                    request.resource.data.amount is number &&
                    request.resource.data.title is string;
      allow update, delete: if false;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.patientId == request.auth.uid;
      allow create: if isAuthenticated() &&
                    request.resource.data.patientId == request.auth.uid &&
                    request.resource.data.title is string;
      allow update: if isAuthenticated() &&
                    resource.data.patientId == request.auth.uid &&
                    request.resource.data.patientId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.patientId == request.auth.uid;
    }

    // Reviews (readable by all authenticated patients, writable by author)
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                    request.resource.data.patientId == request.auth.uid &&
                    request.resource.data.targetId is string &&
                    request.resource.data.rating is number &&
                    request.resource.data.rating >= 1 &&
                    request.resource.data.rating <= 5;
      allow update: if isAuthenticated() && resource.data.patientId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.patientId == request.auth.uid;
    }

    // Support tickets
    match /support_tickets/{ticketId} {
      allow read: if isAuthenticated() && resource.data.patientId == request.auth.uid;
      allow create: if isAuthenticated() &&
                    request.resource.data.patientId == request.auth.uid &&
                    request.resource.data.subject is string;
      allow update: if isAuthenticated() && resource.data.patientId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.patientId == request.auth.uid;
    }

    // Insurance claims
    match /insurance_claims/{claimId} {
      allow read: if isAuthenticated() && resource.data.patientId == request.auth.uid;
      allow create: if isAuthenticated() &&
                    request.resource.data.patientId == request.auth.uid &&
                    isValidInsuranceClaim(request.resource.data);
      allow update: if isAuthenticated() && resource.data.patientId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.patientId == request.auth.uid;
    }

    function isValidInsuranceClaim(data) {
      return data.patientId is string &&
             data.policyNumber is string &&
             data.claimedAmount is number &&
             data.status in ['SUBMITTED', 'UNDER_REVIEW', 'APPROVED', 'SETTLED'];
    }

    // Medical records (digital health locker)
    match /medical_records/{recordId} {
      allow read: if isAuthenticated() && resource.data.patientId == request.auth.uid;
      allow create: if isAuthenticated() &&
                    request.resource.data.patientId == request.auth.uid &&
                    isValidMedicalRecord(request.resource.data);
      allow update: if isAuthenticated() &&
                    resource.data.patientId == request.auth.uid &&
                    isValidMedicalRecord(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.patientId == request.auth.uid;
    }

    function isValidMedicalRecord(data) {
      return data.patientId is string &&
             data.title is string &&
             data.title.size() > 0 &&
             data.category is string &&
             data.recordDate is string &&
             (!('attachmentPath' in data) || (data.attachmentPath is string && data.attachmentPath.size() <= 1024)) &&
             (!('attachmentName' in data) || (data.attachmentName is string && data.attachmentName.size() <= 256));
    }

    // Secure consultation chat messages (with optional prescription attachments)
    match /chat_messages/{messageId} {
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );
      allow create: if isAuthenticated() &&
                    request.resource.data.senderId == request.auth.uid &&
                    isValidChatMessage(request.resource.data);
      allow update: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );
      allow delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
    }

    function isValidChatMessage(data) {
      return data.consultationId is string &&
             data.consultationId.size() > 0 &&
             data.consultationId.size() <= 120 &&
             data.senderId is string &&
             data.recipientId is string &&
             data.recipientId.size() > 0 &&
             data.message is string &&
             data.message.size() <= 4000 &&
             (!('attachmentType' in data) || (data.attachmentType is string && data.attachmentType in ['', 'IMAGE', 'PDF'])) &&
             (!('attachmentPath' in data) || (data.attachmentPath is string && data.attachmentPath.size() <= 1024)) &&
             (!('attachmentName' in data) || (data.attachmentName is string && data.attachmentName.size() <= 256)) &&
             (data.message.size() > 0 || ('attachmentPath' in data && data.attachmentPath.size() > 0));
    }
  }
}
